PORT=3000
# Optional exact public origin (recommended behind a proxy)
PUBLIC_ORIGIN=
# Optional browser ICE configuration, JSON array. Use short-lived TURN credentials in production.
ICE_SERVERS=

# Optional server-only YouTube Data API v3 key (restricted to YouTube Data API).
YOUTUBE_API_KEY=

# Optional isolated LiveKit project. WSS and server-side secrets; never expose these to the browser.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
